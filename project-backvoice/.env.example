# Required for AI analysis via Groq Whisper + GPT-OSS.
GROQ_API_KEY=

# Optional Groq key rotation for rate-limit fallback.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEYS=

# Optional Typhoon ASR. If set, Typhoon handles STT and pyannote diarization is best-effort.
TYPHOON_API_KEY=

# Optional HuggingFace token if you install requirements-diarization.txt.
HF_TOKEN=

# Production frontend origins allowed by FastAPI CORS.
FRONTEND_URL=https://your-frontend.vercel.app
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Optional, useful for Vercel preview URLs. Example:
# CORS_ALLOWED_ORIGIN_REGEX=https://.*\.vercel\.app
